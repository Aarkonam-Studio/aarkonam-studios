# ==============================================================================
# AARKONAM STUDIOS — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to `.env` or `.env.local` for production deployment.
# Never commit real API keys, passwords, or service accounts to version control.

# ------------------------------------------------------------------------------
# EMAILJS NOTIFICATION RELAY CONFIGURATION
# ------------------------------------------------------------------------------
# Obtain these values from your EmailJS dashboard (https://dashboard.emailjs.com):
# 1. Service ID: Under Email Services (e.g., service_gmail, service_aarkonam)
# 2. Template ID: Under Email Templates (e.g., template_contact_relay)
# 3. Public Key: Under Account > API Keys (Client-side public key)
VITE_EMAILJS_SERVICE_ID=YOUR_EMAILJS_SERVICE_ID
VITE_EMAILJS_TEMPLATE_ID=YOUR_EMAILJS_TEMPLATE_ID
VITE_EMAILJS_PUBLIC_KEY=YOUR_EMAILJS_PUBLIC_KEY

# ------------------------------------------------------------------------------
# STUDIO TRANSMISSION & FALLBACK ENDPOINT
# ------------------------------------------------------------------------------
# Contact form submission fallback endpoint (Serverless function / CRM webhook)
VITE_CONTACT_API_ENDPOINT=https://api.aarkonamstudios.com/v1/inquiries/placeholder

# Studio Transmission Contact (Target inquiry address for documentation/receipts)
VITE_STUDIO_CONTACT_EMAIL=contact@aarkonamstudios.placeholder

# ------------------------------------------------------------------------------
# FIREBASE PRODUCTION SUITE (OPTIONAL / ENTERPRISE DEPLOYMENT)
# ------------------------------------------------------------------------------
# If left empty, Aarkonam Studios uses the hardened local administrative sandbox.
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY_HERE
VITE_FIREBASE_AUTH_DOMAIN=aarkonam-studios-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=aarkonam-studios-prod
VITE_FIREBASE_STORAGE_BUCKET=aarkonam-studios-prod.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
